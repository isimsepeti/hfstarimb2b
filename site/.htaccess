<IfModule mod_rewrite.c>
    RewriteEngine On

    # Uygulama içi klasörler web'den erişilemez; tek giriş noktası index.php
    RewriteRule ^(app|cli|config|data|database|storage)(/|$) - [F,L]
    RewriteRule ^(themes|yonetim|uploads)/.*\.(php\d?|phtml|phar|inc)$ - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|\.git.*|.*\.(sql|zip|log|bak|xlsx|md))$ - [F,L,NC]

    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^index\.php$ - [L]
    RewriteRule ^yonetim/assets/ - [L]
    RewriteRule ^yonetim(/.*)?$ index.php [L]
    RewriteRule ^robots\.txt$ index.php [L]
    RewriteRule ^sitemap(_index)?\.xml$ index.php [L]
    RewriteRule ^(product|category|page|blog)-sitemap\.xml$ index.php [L]
    RewriteRule ^manifest\.webmanifest$ index.php [L]
    RewriteRule ^llms\.txt$ index.php [L]
    RewriteRule ^feed/?$ index.php [L]

    # Olmayan resim/css/js dosyası PHP'yi (ve tüm uygulamayı) çalıştırmasın, doğrudan 404
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule \.(png|jpe?g|gif|webp|avif|svg|ico|css|js|map|woff2?|ttf|eot|pdf)$ - [R=404,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/rss+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule pagespeed_module>
    ModPagespeedDisableFilters rewrite_images,resize_images,recompress_images,convert_jpeg_to_webp,convert_png_to_webp,inline_images
</IfModule>

ErrorDocument 404 "Not Found"
DirectoryIndex index.php
Options -Indexes
